{
  "name": "mi-clima-by-it-rosario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agregador de datos oficiales de clima, alerta de inundacion y niveles hidrometricos de la Cuenca del Plata.",
  "author": "Juan Martín Villanueva",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "design:check": "impeccable detect src/",
    "deploy": "npm run build && wrangler deploy",
    "verify": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "astro": "^7.4.2",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.4",
    "impeccable": "^4.7.0",
    "msw": "^3.0.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
