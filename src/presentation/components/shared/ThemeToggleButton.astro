---
import type { TranslationSchema } from "../../i18n/translations/es";

interface Props {
  translations: TranslationSchema;
}

const { translations } = Astro.props;

/**
 * Iconos del selector de tema. Los tres se renderizan y el modulo de
 * `themeToggle` muestra el que corresponde, de modo que el HTML ya sea
 * accesible sin JavaScript.
 */
const themeIcons = [
  {
    preference: "auto" as const,
    path: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 0c2.5 2.6 3.8 5.5 3.8 9s-1.3 6.4-3.8 9m0-18C9.5 5.6 8.2 8.5 8.2 12s1.3 6.4 3.8 9",
  },
  {
    preference: "light" as const,
    path: "M12 4V2m0 20v-2m8-8h2M2 12h2m13.7-5.7 1.4-1.4M4.9 19.1l1.4-1.4m0-11.4L4.9 4.9m14.2 14.2-1.4-1.4M15.5 12a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z",
  },
  {
    preference: "dark" as const,
    path: "M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z",
  },
];
---

<button
  type="button"
  class="button button--ghost theme-toggle"
  data-theme-toggle
  data-theme-label-prefix={translations.theme.label}
  data-theme-label-auto={translations.theme.auto}
  data-theme-label-light={translations.theme.light}
  data-theme-label-dark={translations.theme.dark}
  aria-label={translations.theme.toggle}
  title={translations.theme.toggle}
>
  {
    themeIcons.map((icon) => (
      <span class="theme-toggle__icon" data-theme-icon={icon.preference} hidden={icon.preference !== "auto"}>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentcolor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d={icon.path} />
        </svg>
      </span>
    ))
  }
  <span class="visually-hidden" data-theme-status>
    {`${translations.theme.label}: ${translations.theme.auto}`}
  </span>
</button>
