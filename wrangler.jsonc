{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-clima-by-it-rosario",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": false
  }
}
